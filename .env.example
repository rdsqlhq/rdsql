# rdSQL Desktop — local development environment
#
# The open-source build works out of the box with NO configuration here.
# `npm install && npm run tauri dev` runs the full app — every database
# driver (PostgreSQL, MySQL, SQLite, DuckDB, MongoDB, Redis, S3-compatible
# storage) works with zero setup.
#
# The two variables below only matter if you're building against a
# self-hosted rdSQL backend (accounts, device pairing, encrypted sync,
# entitlement checks — see src-tauri/src/commands/backend.rs). They are
# read at COMPILE time via Rust's option_env!(), not at runtime, so they
# must be exported in your shell (or your build tool) before running
# `cargo build` / `npm run tauri build` — a .env file here is not read
# automatically.
#
# Leaving these unset is the normal/default case: backend_is_cloud_configured()
# returns false and the app runs fully featured with cloud sign-in, sync, and
# entitlement features simply disabled.

# Base URL of a self-hosted rdSQL backend API, e.g. https://your-backend.example.com/api
RDSQL_API_BASE=

# Base URL of the web app that serves the login page for that backend
RDSQL_WEB_BASE=
