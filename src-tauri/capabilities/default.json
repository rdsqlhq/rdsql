{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "identifier": "default",
  "description": "Default capabilities for rdSQL Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-create",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "updater:default",
    "process:allow-restart",
    "deep-link:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "**",
        "$HOME/**",
        "$HOME/Desktop/**",
        "$HOME/Documents/**",
        "$HOME/Downloads/**"
      ]
    }
  ]
}
